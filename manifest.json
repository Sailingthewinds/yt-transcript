{
  "manifest_version": 3,
  "name": "YT Transcript",
  "version": "1.1.0",
  "description": "A Transcript button next to Share. One click, and the whole transcript is on your clipboard.",
  "permissions": ["clipboardWrite", "scripting"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "action": {
    "default_title": "Copy transcript"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "grab-transcript": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Copy transcript"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
